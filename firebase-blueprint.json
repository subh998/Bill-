{
  "entities": {
    "BusinessProfile": {
      "title": "BusinessProfile",
      "description": "Seller business header, GSTIN, bank details, signatory, and next invoice counter.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated owner UID" },
        "companyName": { "type": "string" },
        "companyAddress": { "type": "string" },
        "companyState": { "type": "string" },
        "companyPinCode": { "type": "string" },
        "companyGstin": { "type": "string" },
        "cinNo": { "type": "string" },
        "bankName": { "type": "string" },
        "bankAccountNumber": { "type": "string" },
        "bankIfsc": { "type": "string" },
        "authorisedSignatory": { "type": "string" },
        "termsAndConditions": { "type": "string" },
        "defaultQtyUnit": { "type": "string" },
        "nextInvoiceNumber": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": [
        "userId",
        "companyName",
        "companyAddress",
        "companyState",
        "companyPinCode",
        "companyGstin",
        "cinNo",
        "bankName",
        "bankAccountNumber",
        "bankIfsc",
        "authorisedSignatory",
        "termsAndConditions",
        "defaultQtyUnit",
        "nextInvoiceNumber",
        "createdAt",
        "updatedAt"
      ]
    },
    "Party": {
      "title": "Party",
      "description": "Saved buyer/receiver or consignee directory entry for quick bill autofill.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "gstin": { "type": "string" },
        "state": { "type": "string" },
        "pinCode": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "name",
        "address",
        "gstin",
        "state",
        "pinCode",
        "phone",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupplyBill": {
      "title": "SupplyBill",
      "description": "Tally-style Bill of Supply / Tax Invoice document with receiver, consignee, line items, taxes, transport, and bank details.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "documentType": { "type": "string", "enum": ["Bill of Supply", "Tax Invoice"] },
        "copyType": { "type": "string", "enum": ["ORIGINAL", "DUPLICATE", "TRIPLICATE", "EXTRA_OC"] },
        "invoiceNumber": { "type": "string" },
        "invoiceDate": { "type": "string" },
        "reverseCharge": { "type": "string", "enum": ["N", "Y"] },
        "placeState": { "type": "string" },
        "placePinCode": { "type": "string" },
        "transportMode": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "transporterName": { "type": "string" },
        "driverPhone": { "type": "string" },
        "bhadaAmount": { "type": "number" },
        "truckAdvance": { "type": "number" },
        "sellerName": { "type": "string" },
        "sellerAddress": { "type": "string" },
        "sellerState": { "type": "string" },
        "sellerPinCode": { "type": "string" },
        "sellerGstin": { "type": "string" },
        "sellerCinNo": { "type": "string" },
        "bankName": { "type": "string" },
        "bankAccountNumber": { "type": "string" },
        "bankIfsc": { "type": "string" },
        "authorisedSignatory": { "type": "string" },
        "termsAndConditions": { "type": "string" },
        "receiverName": { "type": "string" },
        "receiverAddress": { "type": "string" },
        "receiverPoNo": { "type": "string" },
        "receiverGstin": { "type": "string" },
        "receiverState": { "type": "string" },
        "receiverPinCode": { "type": "string" },
        "consigneeName": { "type": "string" },
        "consigneeAddress": { "type": "string" },
        "consigneeGstin": { "type": "string" },
        "consigneeState": { "type": "string" },
        "consigneePinCode": { "type": "string" },
        "qtyUnitLabel": { "type": "string" },
        "items": { "type": "array" },
        "totalBeforeTax": { "type": "number" },
        "cgstRate": { "type": "number" },
        "sgstRate": { "type": "number" },
        "igstRate": { "type": "number" },
        "totalTaxAmount": { "type": "number" },
        "totalAfterTax": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "documentType",
        "copyType",
        "invoiceNumber",
        "invoiceDate",
        "reverseCharge",
        "placeState",
        "placePinCode",
        "transportMode",
        "vehicleNumber",
        "transporterName",
        "driverPhone",
        "bhadaAmount",
        "truckAdvance",
        "sellerName",
        "sellerAddress",
        "sellerState",
        "sellerPinCode",
        "sellerGstin",
        "sellerCinNo",
        "bankName",
        "bankAccountNumber",
        "bankIfsc",
        "authorisedSignatory",
        "termsAndConditions",
        "receiverName",
        "receiverAddress",
        "receiverPoNo",
        "receiverGstin",
        "receiverState",
        "receiverPinCode",
        "consigneeName",
        "consigneeAddress",
        "consigneeGstin",
        "consigneeState",
        "consigneePinCode",
        "qtyUnitLabel",
        "items",
        "totalBeforeTax",
        "cgstRate",
        "sgstRate",
        "igstRate",
        "totalTaxAmount",
        "totalAfterTax",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/profile/{docId}": {
      "schema": { "$ref": "#/entities/BusinessProfile" },
      "description": "Authenticated user's business profile (stored at docId='business')."
    },
    "/users/{userId}/parties/{partyId}": {
      "schema": { "$ref": "#/entities/Party" },
      "description": "Authenticated user's saved receiver and consignee parties."
    },
    "/users/{userId}/bills/{billId}": {
      "schema": { "$ref": "#/entities/SupplyBill" },
      "description": "Authenticated user's created Bills of Supply / Tax Invoices."
    }
  }
}
